# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Claude (first-party API) ---
ANTHROPIC_API_KEY=

# --- or Claude on Amazon Bedrock (needs: pip install -e ".[bedrock]") ---
# Selected automatically when BEDROCK_MODEL_ID is set and ANTHROPIC_API_KEY is not.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=            # or AWS_PROFILE=<profile in ~/.aws>, or AWS_BEARER_TOKEN_BEDROCK=<Bedrock API key>
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# --- or Claude on Microsoft Foundry (Azure) ---
# FERRERO_LLM_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
# ANTHROPIC_FOUNDRY_API_KEY=

# Client-side refusal fallback on Bedrock / Foundry (the first-party API uses server-side fallbacks).
# Defaults: claude-opus-4-8 on Foundry, none on Bedrock.
# FERRERO_FALLBACK_MODEL=

# --- Assistant ---
# FERRERO_MODEL=claude-opus-5-5
# FERRERO_EFFORT=medium            # low | medium | high | xhigh | max
# FERRERO_DEMO_TODAY=2026-11-05    # frozen demo date, same as the notebook's DEMO_TODAY
# FERRERO_ORG_NAME=Dolce Group International S.A.

# --- Paths (defaults shown) ---
# FERRERO_PACK_DIR=docs/Ferrero_Demo_Pack
# FERRERO_DATA_DIR=data

# --- Text recognition for scanned PDFs (Baidu Unlimited-OCR-2; see README "Text recognition") ---
# FERRERO_OCR_ENGINE=auto           # auto | server | local | off. auto: the server below if set, else results
#                                   # from `python -m ferrero.ocr` (cached in data/ocr)
# FERRERO_OCR_URL=http://gpu-host:10000/v1   # OpenAI-compatible endpoint serving baidu/Unlimited-OCR-2 (SGLang)
# FERRERO_OCR_MODEL_DIR=models/Unlimited-OCR-2
# FERRERO_OCR_MODE=gundam           # local engine: gundam (page + detail tiles, the model's default) | base (faster)
# FERRERO_OCR_EXPERTS=auto          # local engine on a CPU: ram | mapped | int8; auto = mapped when < 8 GB is free
# FERRERO_OCR_MIN_CONFIDENCE=0.80   # below: not indexed ("OCR confidence below threshold")
# FERRERO_OCR_REVIEW_CONFIDENCE=0.90  # pages below: indexed, flagged for review

# --- Document sync from SharePoint (Microsoft Graph, app-only) ---
# FERRERO_SP_TENANT_ID=
# FERRERO_SP_CLIENT_ID=
# FERRERO_SP_CLIENT_SECRET=
# FERRERO_SP_HOSTNAME=contoso.sharepoint.com
# FERRERO_SP_SITE_PATH=Legal
# FERRERO_SP_LIBRARY=Cases

# --- Web app ---
# FERRERO_PORT=8000                 # start.cmd and `python -m ferrero.web` listen here; the browser opens http://localhost:<port>

# --- Superset dashboards (Dashboards page, "Case dashboard" button on each case) ---
# Ferrero signs in with this account, finds the dashboards whose title contains FERRERO_SUPERSET_TITLE, turns on
# embedding for any that lack it, and gives the browser a guest token per dashboard with the persona's row rules.
# The account needs "can grant guest token on SecurityRestApi" (Admin has it); Superset needs the EMBEDDED_SUPERSET
# feature flag, and its GUEST_ROLE_NAME role needs access to the Ferrero datasets.
# Superset only lets the sites in its Content-Security-Policy frame-ancestors embed it: open Ferrero from one of
# them (set FERRERO_PORT to match, e.g. 8090 for http://localhost:8090) or add Ferrero's address there.
# FERRERO_SUPERSET_URL=http://superset-host:8088
# FERRERO_SUPERSET_USERNAME=
# FERRERO_SUPERSET_PASSWORD=
# FERRERO_SUPERSET_AUTH_PROVIDER=db          # db | ldap
# FERRERO_SUPERSET_TITLE=Ferrero             # which dashboards to show (title contains this text)
# FERRERO_SUPERSET_AUTO_EMBED=true           # false: only dashboards already set to "Embed" in Superset are shown
# FERRERO_SUPERSET_ALLOWED_DOMAINS=          # comma-separated; used when Ferrero turns embedding on (empty: any site)
# FERRERO_SUPERSET_DASHBOARDS=Title|https://…;Title|https://…   # fallback without an account: plain links in frames
